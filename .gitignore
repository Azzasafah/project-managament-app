# Dependencies
/node_modules
/vendor

# Environment & Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
.env.backup
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
auth.json

# Local Databases (SQLite & dumps)
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite3
/database/*.db
/database/*.sql

# Storage & Caches
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail

# Vite & Build Assets (Uncommented for shared hosting/cPanel deployment)
# /public/build
/public/hot
/public/storage

# Testing & Tools
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
Homestead.json
Homestead.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# AI Agent & Assistant Files (NEVER COMMIT)
/.agents
/.gemini
/.claude
/.cursor

# IDE & Editor Configs
/.fleet
/.idea
/.nova
/.vscode
/.zed
*.sublime-project
*.sublime-workspace
